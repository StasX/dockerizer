<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!-- Jenkins global variable scripts use lower camel case filenames. -->
    <Match>
        <Class name="dockerizer"/>
        <Bug pattern="NM_CLASS_NAMING_CONVENTION"/>
    </Match>

    <!-- Groovy dynamic calls from buildImage, tag and push invoke this method. -->
    <Match>
        <Class name="dockerizer"/>
        <Method name="validateArguments" params="java.lang.String,java.lang.String,java.lang.String" returns="void"/>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>

    <!--
        Groovy compiler-generated __$stMC field in both the main script
        class and generated closure classes.
    -->
    <Match>
        <Field name="__$stMC"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>

    <!-- Groovy-generated closure serialization warning. -->
    <Match>
        <Class name="~.*\$_.*"/>
        <Field name="__$stMC"/>
        <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
    </Match>

    <!-- Groovy-generated closure classes. -->
    <Match>
        <Class name="~.*\$_.*"/>
        <Bug pattern="SE_NO_SERIALVERSIONID"/>
    </Match>
</FindBugsFilter>
