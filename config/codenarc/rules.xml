<?xml version="1.0" encoding="UTF-8"?>

<ruleset xmlns="http://codenarc.org/ruleset/1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://codenarc.org/ruleset/1.0
             http://codenarc.org/ruleset-schema.xsd">

    <description>
        CodeNarc rules for the Dockerizer Jenkins Shared Library
    </description>

    <!-- Common programming errors -->
    <ruleset-ref path="rulesets/basic.xml">
        <exclude name="NoDef"/>
    </ruleset-ref>

    <!-- Exception handling -->
    <ruleset-ref path="rulesets/exceptions.xml"/>

    <!-- Unused variables, parameters and imports -->
    <ruleset-ref path="rulesets/unused.xml"/>

    <!-- Unnecessary code -->
    <ruleset-ref path="rulesets/unnecessary.xml">
        <exclude name="UnnecessaryReturnKeyword"/>
    </ruleset-ref>

    <!-- Naming conventions -->
    <ruleset-ref path="rulesets/naming.xml">
        <exclude name="FactoryMethodName"/>
    </ruleset-ref>

    <!-- Formatting -->
    <ruleset-ref path="rulesets/formatting.xml">
        <rule-config name="LineLength">
            <property name="length" value="120"/>
        </rule-config>

        <rule-config name="Indentation">
            <property name="spacesPerIndentLevel" value="4"/>
        </rule-config>
    </ruleset-ref>

    <!-- Security-related checks -->
    <ruleset-ref path="rulesets/security.xml"/>
</ruleset>